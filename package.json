{
  "name": "dsh-team-hub",
  "version": "0.2.7",
  "description": "Turn a single-user DeepSeek Harness instance into a secure, workspace-isolated team service",
  "type": "module",
  "bin": {
    "dsh-team-hub": "bin/dsh-team-hub.js"
  },
  "files": [
    "bin",
    "src",
    "admin-ui",
    "team-ui",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "scripts": {
    "team": "node bin/dsh-team-hub.js team start",
    "build:plugin": "node scripts/build-team-plugin.mjs",
    "test:team": "node --test test/team/*.test.mjs",
    "verify:team-ui": "node scripts/verify-team-ui.mjs",
    "prepack": "npm run build:plugin",
    "start": "node bin/dsh-team-hub.js start",
    "test": "node --test test/*.test.mjs",
    "selftest": "node bin/dsh-team-hub.js selftest",
    "acceptance": "node scripts/acceptance.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "team",
    "gateway",
    "multi-user",
    "workspace-isolation"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "pg": "^8.16.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "esbuild": "^0.25.9",
    "lucide": "^0.468.0",
    "marked": "^18.0.12",
    "playwright": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "^7.8.5",
    "tar": "^7.5.22",
    "yaml": "^2.9.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhoujianbin/dsh-team-hub.git"
  },
  "homepage": "https://github.com/zhoujianbin/dsh-team-hub#readme",
  "bugs": {
    "url": "https://github.com/zhoujianbin/dsh-team-hub/issues"
  }
}
